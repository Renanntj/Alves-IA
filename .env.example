# Ambiente da aplicação
APP_ENV=development
APP_NAME=Alves IA
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Integração de IA (opcional para iniciar a API)
# Provedor padrão: gemini. Altere para "openai" se necessário.
AI_PROVIDER=gemini
AI_LIVE_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Agendamentos e automações
TIMEZONE=America/Recife

# Fase 1: gere valores distintos com `openssl rand -hex 32`.
# Use senhas hexadecimais para evitar caracteres especiais nas URLs.
JWT_SECRET=
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# No Compose o hostname é db. Substitua os marcadores pelas senhas acima.
DATABASE_URL=postgresql+psycopg://alves_app:SUBSTITUA@db:5432/alves
MIGRATION_DATABASE_URL=postgresql+psycopg://alves_owner:SUBSTITUA@db:5432/alves

# Fase 2: app Meta compartilhado, canais cadastrados por clínica.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# Preencha a versão Graph API habilitada no seu app (formato vNN.N).
WHATSAPP_API_VERSION=
REDIS_URL=redis://redis:6379/0

