# Ambiente da aplicação
APP_ENV=development
APP_NAME=Alves IA
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Atendimento IA fica desligado por padrão. Voz usa Whisper/OpenAI, inclusive
# quando o provedor de texto é Gemini; nesse caso, preencha também OPENAI_API_KEY.
AI_PROVIDER=gemini
AI_LIVE_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Agendamentos e automações
TIMEZONE=America/Recife

# Fase 1: gere valores distintos com `openssl rand -hex 32`.
# Use senhas hexadecimais para evitar caracteres especiais nas URLs.
JWT_SECRET=
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# No Compose o hostname é db. Substitua os marcadores pelas senhas acima.
DATABASE_URL=postgresql+psycopg://alves_app:SUBSTITUA@db:5432/alves
MIGRATION_DATABASE_URL=postgresql+psycopg://alves_owner:SUBSTITUA@db:5432/alves

# WhatsApp Cloud API: app Meta compartilhado, canais cadastrados por clínica.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# Preencha a versão Graph API habilitada no seu app (formato vNN.N).
WHATSAPP_API_VERSION=
REDIS_URL=redis://redis:6379/0

# Google Sheets por clínica (OAuth web, acesso somente leitura).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://seu-dominio/v1/integrations/google-sheets/callback
# Gere uma chave AES-256 aleatória em base64; guarde-a como segredo e faça backup seguro.
GOOGLE_SHEETS_ENCRYPTION_KEY=

